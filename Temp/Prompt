create table public.promo_codes (
  id serial not null,
  code character varying(50) not null,
  discount numeric(10, 2) not null,
  type character varying(20) not null,
  used boolean null default false,
  max_uses integer null default 0,
  used_by_user_ids jsonb null default '[]'::jsonb,
  is_active boolean null default true,
  expiry timestamp with time zone null,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  constraint promo_codes_pkey primary key (id),
  constraint promo_codes_code_key unique (code),
  constraint promo_codes_type_check check (
    (
      (type)::text = any (
        (
          array[
            'percentage'::character varying,
            'fixed'::character varying
          ]
        )::text[]
      )
    )
  )
) TABLESPACE pg_default;

create index IF not exists idx_promo_codes_code on public.promo_codes using btree (code) TABLESPACE pg_default;

create index IF not exists idx_promo_codes_active on public.promo_codes using btree (is_active) TABLESPACE pg_default;

create index IF not exists idx_promo_codes_expiry on public.promo_codes using btree (expiry) TABLESPACE pg_default;

create trigger update_promo_codes_updated_at BEFORE
update on promo_codes for EACH row
execute FUNCTION update_updated_at_column ();




Here's the full UI/UX plan with a working interactive mockup. Let me walk you through the design decisions.

How the Marketing Tab is structured
The tab is split into three sections — all accessible from the pill-style tab bar at the top.
Section 1 — Promo Codes (your main tool)
At the top, four metric cards give you a live dashboard: total codes, total uses this week, discount given in EGP this month, and the current top-performing code. Below that is the codes table.
Each row in the table shows the code (in monospace so it's instantly copyable), whether it's a percentage or fixed-EGP type (color-coded badges), the discount value, a visual progress bar for uses vs. max_uses, the expiry date, status, and action buttons.
The "+ New code" button opens a modal form that maps exactly to your create-promo-code edge function payload: code, type (percentage or fixed), discount value, max_uses, expiry, and an active toggle. On submit it calls your edge function with the admin's JWT token — no page reload needed.
Status logic is automatic: if used_by_user_ids.length >= max_uses, it shows "Maxed out"; if expiry < now(), it shows "Expired"; otherwise it reflects is_active.
Section 2 — Banners
Each banner shows a color preview, the English title, subtitle, and a toggle switch. The critical UX rule here: only one banner can be active at a time. Flipping a toggle on one auto-deactivates all others — this is enforced in the UI before even hitting the database. This prevents you from accidentally showing two conflicting banners on the storefront.
Section 3 — Pixels & Analytics
A clean list of your tracking pixels (Meta, TikTok, GA4) with their IDs and a "Connect" button for unlinked ones. Below that is a conversion table showing how each promo code performed — impressions, successful checkouts, and revenue attributed — pulling from your orders data joined against promo_codes.used_by_user_ids.

