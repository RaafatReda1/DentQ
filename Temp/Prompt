create table public."ContactData" (
  id bigint generated by default as identity not null,
  created_at timestamp with time zone not null default now(),
  phones numeric null,
  emails text null,
  constraint ContactData_pkey primary key (id)
) TABLESPACE pg_default;

create table public."ContactForm" (
  id bigint generated by default as identity not null,
  created_at timestamp with time zone not null default now(),
  full_name text null,
  email_address text null,
  phone_number numeric null,
  message text not null,
  client uuid not null,
  constraint ContactForm_pkey primary key (id),
  constraint ContactForm_client_fkey foreign KEY (client) references "Clients" (id) on update CASCADE on delete CASCADE
) TABLESPACE pg_default;


create table public."Footer" (
  id bigint generated by default as identity not null,
  slug_name text null,
  slogan_ar text null,
  "Links" jsonb null,
  created_at timestamp with time zone not null default now(),
  slogan_en text null,
  constraint Footer_pkey primary key (id)
) TABLESPACE pg_default;

create table public."GovernoratesShipping" (
  id bigint generated by default as identity not null,
  "governorateEn" text null,
  "shippingPrice" double precision null default '0'::double precision,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp without time zone null,
  "governorateAr" text null,
  constraint GovernoratesShipping_pkey primary key (id),
  constraint GovernoratesShipping_governorateAr_key unique ("governorateAr"),
  constraint GovernoratesShipping_governorate_key unique ("governorateEn")
) TABLESPACE pg_default;

create table public."StoreSettings" (
  id uuid not null default gen_random_uuid (),
  address_ar text null,
  address_en text null,
  phone text null,
  email text null,
  accent_color text null default '#1a1a2e'::text,
  updated_at timestamp with time zone null default now(),
  constraint storesettings_pkey primary key (id)
) TABLESPACE pg_default;


create table public.navigation_items (
  id serial not null,
  section_key character varying(50) not null,
  section_title_ar character varying(100) not null,
  section_title_en character varying(100) not null,
  item_label_ar character varying(100) not null,
  item_label_en character varying(100) not null,
  item_link character varying(255) not null,
  item_order integer not null,
  section_order integer not null,
  created_at timestamp without time zone null default CURRENT_TIMESTAMP,
  updated_at timestamp without time zone null default CURRENT_TIMESTAMP,
  constraint navigation_items_pkey primary key (id)
) TABLESPACE pg_default;

create index IF not exists idx_section_key on public.navigation_items using btree (section_key) TABLESPACE pg_default;

create index IF not exists idx_section_order on public.navigation_items using btree (section_order, item_order) TABLESPACE pg_default;

create trigger update_navigation_items_updated_at BEFORE
update on navigation_items for EACH row
execute FUNCTION update_updated_at_column ();