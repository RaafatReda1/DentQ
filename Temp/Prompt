### Data loading pattern

Each section uses its own custom hook. All hooks follow this pattern:

```js
function useStoreSettings() {
  const [data, setData] = useState(null);
  const [draft, setDraft] = useState(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState(null);

  useEffect(() => {
    supabase.from('StoreSettings').select('*').single()
      .then(({ data, error }) => {
        if (error) setError(error.message);
        else { setData(data); setDraft(data); }
        setLoading(false);
      });
  }, []);

  const save = async () => {
    setSaving(true);
    const { error } = await supabase
      .from('StoreSettings')
      .upsert({ ...draft, updated_at: new Date().toISOString() });
    setSaving(false);
    if (error) setError(error.message);
    else setData(draft);
  };

  const discard = () => setDraft(data);

  const isDirty = JSON.stringify(draft) !== JSON.stringify(data);

  return { draft, setDraft, loading, saving, error, save, discard, isDirty };
}
```

The `isDirty` flag controls whether the save button is visually active (accent color) or muted. The discard button is only shown when `isDirty` is true.

